{
  "name": "vscode-archarit",
  "displayName": "Archarit",
  "publisher": "bazumtaaveyno-cloud",
  "engines": {
    "vscode": "^1.60.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "archarit",
        "aliases": ["Archarit", "archarit"],
