// 1. Core Language - Int/f32 only
// TOKENS:
// val var let mut fun return if() elif else match guard
// for while loop in break continue true false null
// Int f32 String Bool List Map Set
// .. .* ./ .+ channel send receive open read write close
// upper lower trim split len add remove forEach

val nameConst: String = "Archarit"
var age: Int = 20
let mut score: f32 = 0

fun add(a: f32, b: f32): f32 { return a + b }

if age < 18 { print("kid") } elif age < 60 { print("adult") } else { print("elder") }
if(age < 18){ print("kid") } // C-style also works

match age {
    0..17 => print("kid")
    18..59 => print("adult")
    _ => print("other")
}

guard age > 0 else { return }

for i in 0..10 {
    if i == 5 { continue }
    if i == 10 { break }
}

var state = false
var n = read("Do you wish to continue? yes/no: ")

if n == "yes" {
    state = true
    print("true")
} else {
    state = false
    print("false")
}

