var ball = { x: 40, y: 300, radius: 24, color: red }

animate(ball, x=320, duration=1, easing="bounce")

sequence {
    animate(ball, x=320, duration=1)
    animate(ball, y=500, duration=1)
}

parallel {
    animate($door, open=1, duration=1)
    animate($door.Handle, angle=45, duration=1)
}

timeline($door) {
    keyframe(at=0, open=0, easing="easeIn")
    keyframe(at=1.5, open=1, easing="bounce")
    keyframe(at=3, open=0, easing="easeInOut")
}

play(timeline, duration=3, loop=true)
pause(timeline)
stop(timeline)

loop(infinite=true) {
    animate($car.Wheel, spin=360, duration=1, easing="linear")
}

on_frame({ dt ->
    clear(color=#0b1020)
})

on_click({ print("tap") })
on_hover({ print("hover") })
on_drag({ x, y -> print("drag $x $y") })
on_touch({ print("touch") })
on_tap({ print("tap") })

on_key(key="space") {
