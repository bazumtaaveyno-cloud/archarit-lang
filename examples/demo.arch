// 5. 2D UI & Canvas
// TOKENS:
// 2d canvas stack box text button rect circle line image
// clear draw render sprite getContext particle_system
// on_click on_hover on_drag on_drag_start on_drag_end
// len add remove upper lower trim split

2d App {
    canvas(size=(360, 640), color=#0f172a) {
        stack(direction=vertical, spacing=16, padding=24) {
            text("Archarit UI", size=28, color=white)

            box(width=60, height=60, color=green, radius=30)

            button("Tap", width=140, height=48, color=blue) {
                on_click({
                    print("clicked")
                })
            }
        }

        rect(x=0, y=0, width=100, height=20, color=red)
        circle(x=50, y=50, radius=20, color=blue)
        line(from=(0,0), to=(100,100), color=white, width=2)
        image(path="logo.png", x=200, y=100, width=100, height=100)
        clear(color=#111111)
    }
}

render(App)

// JS-canvas-style context
2d CanvasApp {
    canvas(size=(800, 600)) {
        val ctx = getContext()

        ctx.fillStyle = red
        ctx.fillRect(x=100, y=100, width=200, height=100)

        ctx.beginPath()
        ctx.arc(x=400, y=300, radius=50, start=0, end=360)
        ctx.fill(color=blue)

        ctx.strokeStyle = white
        ctx.lineWidth = 2
        ctx.moveTo(x=0, y=0)
        ctx.lineTo(x=100, y=100)
        ctx.stroke()

        ctx.fillText(text="Hello", x=100, y=50, size=20)
    }
}

// Sprites
val player = sprite(path="player.png", x=100, y=100, width=50, height=50) {
    var vx = 0
    var vy = 0
    collision = true
    collision_shape = "box"
    tag = "player"
}

// Particles
val sparks = particle_system(
    x=400,
    y=300,
    count=100,
    color=orange,
    size=5,
    velocity=(-50..50, -100..0),
    lifetime=2
)

sparks.burst(x=400, y=300, count=50)

// 6. Collision & Physics
// TOKENS:
// collision collision_shape tag collision_layer collides_with
// physics mass bounciness friction is_colliding raycast
// on_collision on_collision_end on_collision_stay destroy

val wall = fn "3d"() {
    geometry = Box(w=10, h=5, d=1)

    collision = true // true / false / "trigger" / "soft"
    collision_shape = "box" // box/circle/polygon/capsule/sphere/mesh
    tag = "wall"
    collision_layer = 0
    collides_with = [0, 1]

    physics = true
    mass = 1
    bounciness = 0.8
    friction = 0.5

    on_collision({ other ->
        print("hit ${other.tag}")
    })

    on_collision_stay({ other ->
        print("still touching ${other.tag}")
    })

    on_collision_end({ other ->
        print("stopped touching ${other.tag}")
    })
}

if is_colliding($box1, $box2) {
    print("hit")
}

val hit = raycast(from=(0,0,0), to=(10,0,0))

if hit.collided {
    print("hit ${hit.object} at ${hit.point}, distance ${hit.distance}")
}

// Global collision layers
physics {
    layer(0, collides_with=[0, 1, 2])
    layer(1, collides_with=[0, 2])
    layer(2, collides_with=[0, 1])
}

// 7. Animation & Events
// TOKENS:
