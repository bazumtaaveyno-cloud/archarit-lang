// ================================================================
// 12. ART & ANIMATION
// TOKENS:
// art sprite vector path fill stroke gradient shader rig bone
// pose skeleton layer blend mask particle sound_reactive
// export import_art
// ================================================================

import archarit.art
import archarit.animation

// Vector art
val logo = art.vector {
    path("M 0 0 L 100 0 L 100 100 Z") {
        fill = #22d3ee
        stroke = white
        stroke_width = 2
    }

    circle(x=150, y=50, radius=30) {
        fill = gradient(from=#f472b6, to=#818cf8, direction="vertical")
    }
}

// Sprite art
val hero = art.sprite("hero.png") {
    x = 100
    y = 100
    scale = 1.0
    rotation = 0
    alpha = 1
    layer = 2
}

// Layers and blending
art.layer("background", blend="normal")
art.layer("characters", blend="normal")
art.layer("effects", blend="add")

// Character rig
val character = art.rig {
    bone("body") {
        bone("arm_left") { length = 40 }
        bone("arm_right") { length = 40 }
        bone("leg_left") { length = 50 }
        bone("leg_right") { length = 50 }
    }
}

// Pose animation
timeline($character) {
    keyframe(at=0.0, pose="idle")
    keyframe(at=0.3, pose="run_step_1")
    keyframe(at=0.6, pose="run_step_2")
    keyframe(at=0.9, pose="idle")
}

play(timeline, duration=0.9, loop=true)

// Particles
val particles = art.particles {
    count = 100
    color = orange
    size = 4
    lifetime = 1.5
    velocity = (-100..100, -200..0)
    gravity = 300
}

particles.burst(x=400, y=300, count=50)

// Shader
val glow = art.shader {
    fragment {
        return mix(color, white, sin(time * 5) * 0.5 + 0.5)
    }
}

hero.effect = glow

// Sound-reactive animation
val music = art.sound("track.mp3")
art.sound_reactive(music, target=$logo, property="scale", range=(1.0, 1.3))

// Export
art.export(logo, path="logo.svg")
art.export(character, path="character.gif", duration=2, fps=60)

