// 2. Runtime & Concurrency
// TOKENS:
// async await go defer app import delay
// channel send receive on_start on_close

import archarit.app

app(name="ArcharitApp") {
    on_start({
        go {
            delay(1)
            print("hi")
        }
    })

    on_close({
        print("cleanup")
    })
}

defer print("cleanup")

