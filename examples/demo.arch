// 3. Error & Safety
// TOKENS:
// try catch guard Result Ok Error is_ok value error

try {
    val data = riskyCall()
} catch e {
    print("error $e")
}

fun getUser(id: Int) -> Result<User, String> {
    if id == 0 {
        return Error("user not found")
    }
    return Ok(User(name="John"))
}

val result = getUser(1)

if result.is_ok() {
    print(result.value().name)
} else {
    print(result.error())
}

guard let user = getUser(1).value() else {
    print("no user")
    return
}

