}

// Custom easing
fun myEase(t: f32) -> f32 {
    return t * t
}

animate($box, x=10, duration=2, easing=myEase)

// 8. Web/API/WebSockets
// TOKENS:
// server route fetch websocket use middleware
// on_connect on_message on_disconnect broadcast broadcast_except
// request response json html status param header body method
// GET POST PUT DELETE

server(port=8080) {
    use(authMiddleware)

    route(path="/", method=GET) {
        return html("<h1>Hello Archarit</h1>")
    }

    route(path="/api/door/:id", method=GET) {
        val id = request.param("id")
        return json(data={ "opened": id })
    }

    route(path="/api/user", method=POST) {
        val body = request.body()
        return json(data={ "created": body.name }, status=201)
    }

    route(path="/api/user/:id", method=PUT) {
        val id = request.param("id")
        val body = request.body()
        return json(data={ "updated": id })
    }

    route(path="/api/user/:id", method=DELETE) {
        val id = request.param("id")
        return json(data={ "deleted": id })
    }

    websocket(path="/race") {
        on_connect({ client ->
            print("client ${client.id} joined")
            broadcast({ "type": "player_joined", "id": client.id })
        })

        on_message({ client, msg ->
            val data = msg.json()

            if data.type == "move" {
                broadcast_except(client, {
                    "type": "player_move",
                    "id": client.id,
                    "x": data.x,
                    "y": data.y
                })
            }
        })

        on_disconnect({ client ->
            print("client ${client.id} left")
        })
    }
}

val res = await fetch(
    url="/api/data",
    method=GET,
    headers={
        "Authorization": "Bearer token123",
        "Content-Type": "application/json"
    }
)

if res.status() == 200 {
    print(res.json())
}

// 9. 3D C3L System
// TOKENS:
// fn "3d" fetch.c3l $handle part geometry transform instance
// update render_3d detail texture joint hinge
// Box Sphere Cylinder Capsule rotate translate scale

val car = fn "3d"() {
    geometry = Box(w=4, h=2, d=2)
    var x = 0

    part Wheel {
        var spin = 0
        geometry = Cylinder(r=0.5, h=0.2)
        transform = rotate(x=spin * 360)
    }

    part Door {
        var open = 0
        geometry = Box(w=1, h=1, d=0.1)
        transform = rotate(y=open * 90)
        joint = hinge(axis=y, limit=(0..90))
    }
}

// Create object
val created = fn "3d"() {
    geometry = Sphere(r=2)
    update(color=green)
}

// Fetch existing C3L file
val mansion = fetch.c3l("mansion.c3l")

// Edit whole object
fn "3d"($car) {
    x = 10
    update(color=blue)
}

// Edit part
fn "3d"($car.Wheel) {
    spin = 90
}

// Materials and detail
fn "3d"($car) {
    detail(texture="metal.png", tiling=4, strength=0.8)
}

// Instances
fn "3d"($mansion) {
    instance(template=car, at=(0, 0, 0), random_rotate=(0..5))
}

render_3d($car)

// 10. AI & Data
// TOKENS:
// ai.model ai.train load_csv save predict generate ask
// SELECT FROM WHERE ORDER BY DESC ASC
// rand random sin cos sqrt abs floor round min max
// forEach .* ./ DOT matrix slicing
// classification detection chat generation reinforcement
// epochs batch_size learning_rate optimizer loss
// validation_split augmentation early_stopping save_best
// on_epoch on_episode env state action reward

val data = load_csv("houses.csv")

val q = SELECT(*) FROM data WHERE price < 500000 ORDER BY price DESC

val model = ai.train(
    data=data,
    model="resnet",
    task="classification",
    epochs=10,
    batch_size=32,
    learning_rate=0.001,
    optimizer="adam",
    loss="crossentropy",
    validation_split=0.2,
    augmentation=true,
    early_stopping=true,
    save_best=true,
    on_epoch({ epoch, loss, accuracy ->
        print("Epoch $epoch: loss=$loss, accuracy=$accuracy")
    })
)

model.save("my_model.archarit")

val loaded = ai.model("my_model.archarit")
val prediction = loaded.predict(image="house.png")

// Chat / generation
val chat = ai.model("gpt")
val answer = await chat.ask("What is Archarit?")

val imageModel = ai.model("stable-diffusion")
val generated = await imageModel.generate(prompt="a red dragon with wings")

// Reinforcement learning
val env = {
    state: [player.x, player.y, enemy.x, enemy.y],
    action: ["left", "right", "jump"],
    reward: if is_colliding(player, coin) { 10 } else { -1 }
}

val agent = ai.train(
    env=env,
    model="dqn",
    task="reinforcement",
    episodes=1000,
    on_episode({ episode, reward ->
        print("Episode $episode: reward $reward")
    })
)

val action = agent.predict(state=[player.x, player.y, enemy.x, enemy.y])

